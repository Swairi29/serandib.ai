#  SERANDIB — .gitignore
#  CSE Financial Intelligence · RAG Pipeline


# ── Corpus data (large files, never commit raw PDFs) ───
data/
!data/.gitkeep


#  Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/


# ── Python 
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt
.installed.cfg

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/


# ── Jupyter notebooks 
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*.ipynb_checkpoints


# ── MLflow 
mlflow/mlruns/
mlruns/
mlartifacts/


# ── ChromaDB 
chroma/
chromadb/
*.chroma
data/chroma/


# ── IDE & editors 
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.cursor/


# ── OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini


# ── Logs & temp 
*.log
logs/
*.tmp
*.temp
.cache/


# ── Test & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/


# ── Docker 
*.dockerignore
docker-compose.override.yml